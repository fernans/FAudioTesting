						<FAudioNodeBiquad frec=5000 amount=-20 q=0.1 mode=3 />
						<FAudioNodeTone tone=5000 />
					</FAudioNodeVocoder>
				</FAudioNodeMix>
			</FAudioNodeMix>
		</FAudioNodeMix>
		<FAudioNodeDelay amount=3 />
		</FAudioNodeTube>
