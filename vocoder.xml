<Root>
<FAudio>
	<FAudioParameters>
		<!-- ejemplo parametros
		<FAudioParameter ID="param" input="X" extern />
		<FAudioParameterSet ID="set" input="X" output=1 />
		<FAudioParameterOscilator ID="oscilador" frecuencia=1 amplitud=1 extern />
		<FAudioParameterRange ID="range" inmin=0 inmax=1 outmin=0 outmax=1 />
