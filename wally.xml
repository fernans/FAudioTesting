<FAudio>
	<FAudioParameters>
		<FAudioParameter ID="Y" input=0.25 />
		<FAudioParameterRange ID="rY" input="Y" inmin=1 inmax=0 outmin=0 outmax=0.5 />
		<FAudioParameter ID="X" input=0.25 />
		<FAudioParameterRange ID="rX" input="X" inmin=1 inmax=0 outmin=0.5 outmax=0 />
		<!-- ejemplo parametros
		<FAudioParameter ID="param" input="X" extern />
		<FAudioParameterSet ID="set" input="X" output=1 />
		<FAudioParameterOscilator ID="oscilador" frecuencia=1 amplitud=1 extern />
		<FAudioParameterRange ID="range" inmin=0 inmax=1 outmin=0 outmax=1 />
		<FAudioParameterTransition ID="transition" input=1 target=0 time=1 />
		-->
	</FAudioParameters>
	<FAudioGraph>
		<FAudioNodeSwitch select=1>
			<FAudioNodeTube>
				<FAudioNodePitch amount="rY" />
				<FAudioNodePitch amount="rX" />
			</FAudioNodeTube>
            <FAudioNodeMix volumeA=1 volumeB=1 >
				<FAudioNodeTube>
					<FAudioNodePitch amount="rY" />
				</FAudioNodeTube>
				<FAudioNodeTube>
					<FAudioNodePitch amount="rX" />
				</FAudioNodeTube>
			</FAudioNodeMix>
		</FAudioNodeSwitch>
		
		<!-- ejemplo nodos
		<FAudioNodeMix volumeA=1 volumeB=1 >
			<FAudioNodeTube>
			  <FAudioNodeSwitch select=1 >
				<FAudioNodeNull />
				<FAudioNodeMute />
				<FAudioNodeLowPass frecuencia=22050 />
				<FAudioNodeHiPass frecuencia=22050 />
				<FAudioNodeEQ3 frec1=11000 frec2=22000 value1=1 value2=1 value3=1 />
				<FAudioNodeTone tone=440 volume=1 />
				<FAudioNodeVolume volume=1 />
				<FAudioNodeDelay amount=1 />
				<FAudioNodeRDelay amount=1 volume=0.8 />
				<FAudioNodePitch amount=0 />
				<FAudioNodeCompressor limit=32000 ratio=20 attack=0 release=0 />
				<FAudioNodeWav volume=1 loop=1 position=0 filename="carrier.wav" />
			  </FAudioNodeSwitch>
			</FAudioNodeTube>
		</FAudioNodeMix>
		-->
	</FAudioGraph>
</FAudio>
